# Database (Neon PostgreSQL)
# POOLED connection string (required in production runtime on Vercel).
# Includes '-pooler' in hostname.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# DIRECT unpooled connection string (required ONLY for migrations; not needed in Vercel runtime).
# Does NOT include '-pooler' in hostname.
DIRECT_DATABASE_URL=postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require

# Authentication
# 256-bit or longer random string for JWT signing
JWT_ACCESS_SECRET=your-secure-jwt-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_DAYS=30

# Application (defaults to port 3000 and development if omitted)
NODE_ENV=development
PORT=3000
